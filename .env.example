# PostgreSQL connection string — required for production.
# Replace with your actual connection string (do not commit real credentials).
# Format: postgresql://user:password@host:port/database?sslmode=require
#
# Example for Neon:
# DATABASE_URL="postgres://user:password@ep-xxxx.region.neon.tech/database?sslmode=require"
#
# For local development with a local PostgreSQL instance:
# DATABASE_URL="postgresql://user:password@localhost:5432/unrot_daily?sslmode=prefer"

DATABASE_URL="postgresql://user:password@localhost:5432/unrot_daily?sslmode=prefer"

# Public application URL (client-side links, analytics route context).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Toggle analytics event recording. Set to "true" in deployment to record real events.
NEXT_PUBLIC_ANALYTICS_ENABLED="false"

# Demo mode: enable/disable demo return preview.
DEMO_MODE="true"
